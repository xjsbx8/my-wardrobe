# You can set a vision provider here, or use the in-app Settings panel.
# Supported: kimi, qwen, deepseek, ark, custom
WARDROBE_VISION_PROVIDER=ark
# Provider-specific key alternatives: KIMI_API_KEY, DASHSCOPE_API_KEY,
# DEEPSEEK_API_KEY, ARK_API_KEY, WARDROBE_VISION_API_KEY
# WARDROBE_VISION_BASE_URL=
# WARDROBE_VISION_MODEL=

# Optional image generation: ark, ark-plan, custom.
# Agent Plan image generation uses a dedicated key and the /api/plan/v3 endpoint.
# WARDROBE_IMAGE_PROVIDER=ark-plan
# ARK_AGENT_PLAN_API_KEY=
# WARDROBE_IMAGE_API_KEY=
# WARDROBE_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# WARDROBE_IMAGE_MODEL=doubao-seedream-5-0-pro
# WARDROBE_IMAGE_QUALITY=high

# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png
